{
  "version": 1,
  "about": "One source for the planner skill and the picker on the website. Each question has options; each item says which answers include it. An option with `agreesWith` does not conflict with detection that finds that other option (sign in later, and Sign in with Apple found in the app). An item with no `when` is always in the plan. `when` lists question ids with the option ids that turn the item on; all listed questions must match (AND), any option within one question matches (OR). `doneWhen` uses the same shape: when it matches, the item is still listed but starts ticked as likely done (the user can untick it). `nudge` is the short name the agent says (\"Next: <nudge>. Continue?\"). `needs` lists ids from needs.json: what the step needs before it starts, in the order `plan.mjs ready` checks them. An entry can also be {\"id\", \"when\"}, with `when` in the same shape as an item's.",
  "questions": [
    {
      "id": "stage",
      "q": "Where is your app now?",
      "options": [
        {
          "id": "idea",
          "label": "An idea, or a prototype that is not an Expo app yet"
        },
        {
          "id": "expo",
          "label": "An Expo app that runs on my phone or the simulator"
        },
        {
          "id": "testflight",
          "label": "On TestFlight, not on the App Store yet"
        },
        {
          "id": "store",
          "label": "On the App Store"
        }
      ],
      "default": "expo"
    },
    {
      "id": "backend",
      "q": "Does the app need a server?",
      "options": [
        {
          "id": "none",
          "label": "No. Everything stays on the phone"
        },
        {
          "id": "hosted",
          "label": "Yes, a hosted backend (Supabase, Convex or Firebase)"
        },
        {
          "id": "box",
          "label": "Yes, my own API and database on one cheap box"
        }
      ],
      "default": "box"
    },
    {
      "id": "login",
      "q": "Do users sign in?",
      "options": [
        {
          "id": "none",
          "label": "No accounts"
        },
        {
          "id": "apple",
          "label": "Yes, with Sign in with Apple (and maybe others)"
        },
        {
          "id": "later",
          "label": "Yes, with Sign in with Apple, but after the first TestFlight build",
          "agreesWith": "apple"
        }
      ],
      "default": "apple"
    },
    {
      "id": "paid",
      "q": "Will users pay inside the app?",
      "options": [
        {
          "id": "free",
          "label": "No, it is free"
        },
        {
          "id": "subs",
          "label": "Yes, subscriptions or one-time purchases"
        }
      ],
      "default": "subs"
    },
    {
      "id": "site",
      "q": "Do you want a landing page?",
      "hint": "Apple needs a privacy policy URL and a support URL either way. Without a landing page you host those two pages somewhere else.",
      "options": [
        {
          "id": "yes",
          "label": "Yes, a page for the app on my own domain"
        },
        {
          "id": "no",
          "label": "No, just the privacy and support pages somewhere"
        }
      ],
      "default": "yes"
    },
    {
      "id": "ai",
      "q": "Does the app use AI?",
      "multi": true,
      "options": [
        {
          "id": "chat",
          "label": "A chat or an agent that uses the app's data"
        },
        {
          "id": "import",
          "label": "Turn a shared link or page into data (recipes, products, …)"
        },
        {
          "id": "media",
          "label": "Generated images or video (store page, social, in-app)"
        }
      ],
      "default": []
    },
    {
      "id": "remote",
      "q": "Do you want to fix things from your phone?",
      "options": [
        {
          "id": "yes",
          "label": "Yes, let me (or my coding agent) reach the box from anywhere"
        },
        {
          "id": "no",
          "label": "Not now"
        }
      ],
      "default": "yes"
    }
  ],
  "phases": [
    {
      "id": "accounts",
      "title": "Accounts and tools"
    },
    {
      "id": "app",
      "title": "The app"
    },
    {
      "id": "box",
      "title": "The box"
    },
    {
      "id": "backend",
      "title": "The backend"
    },
    {
      "id": "features",
      "title": "Features"
    },
    {
      "id": "store",
      "title": "App Store Connect and builds"
    },
    {
      "id": "launch",
      "title": "Store page and submit"
    }
  ],
