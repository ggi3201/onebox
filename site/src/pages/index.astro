---
import Base from "../layouts/Base.astro";
import RouteMap from "../components/RouteMap.astro";
import Picker from "../components/Picker.astro";
import { PLUGINS, SKILLS, skillsFor, APPS, REPO_SLUG, SKIPPABLE, OTHERS } from "../data/kit";
import { GUIDES } from "../data/guides";

const count = SKILLS.length;
const skipTotal = SKIPPABLE.reduce((t, x) => t + x.cost, 0);
const n = (k: number, word: string) => `${k} ${word}${k === 1 ? "" : "s"}`;
const mailto =
  "mailto:geir@lokkesveen.com?subject=" +
  encodeURIComponent("Get my app live") +
  "&body=" +
  encodeURIComponent(
    "The app (link or repo):\n\nWhat works now:\n\nWhere I am stuck:\n\nTestFlight or the App Store:\n\nWhen I want it live:\n",
  );
const bill = [
  { item: "A small VPS, or a mini PC you already own", cost: "€5", per: "month" },
  { item: "Your domain", cost: "€10", per: "year" },
  { item: "Apple Developer Program", cost: "$99", per: "year" },
  { item: "Cloudflare DNS and Tunnel", cost: "€0", per: "" },
  { item: "iOS builds on your own Mac", cost: "€0", per: "" },
  { item: "AWS, Kubernetes, a DevOps person", cost: "—", per: "not needed" },
];
---

<Base
  title="onebox — get your app on the App Store"
  description="Free agent skills and plain guides for getting an Expo app onto the App Store. Need a backend? Run it on one cheap box."
>
  <main>
    <!-- ============ HERO: the label ============ -->
    <section class="hero">
      <div class="wrap hero-grid">
        <div class="hero-copy">
          <p class="kicker">Agent skills · Expo · iOS</p>
          <h1 class="display hero-title"><span>Your app,</span> <span>on the</span> <span>App Store.</span></h1>
          <p class="lede">
            You built something with Claude Code, Codex or Cursor. It works on your phone. Then come certificates,
            App Review, payments and a backend that is still on <code>localhost</code>.
            These skills and guides take you the rest of the way, the way I ship my own apps.
            Need a server? Run it on one cheap box.
          </p>
          <div class="hero-actions">
            <a class="btn" href="#start">Start in three steps <span aria-hidden="true">↓</span></a>
            <a class="btn ghost" href="#help">Or ask me for help</a>
          </div>
        </div>

        <aside class="label-card" aria-label="Shipping label">
          <div class="label-head">
            <span class="kicker">Shipping label</span>
            <span class="label">Nº 001</span>
          </div>
          <dl class="label-rows">
            <div><dt class="label">From</dt><dd>Your Mac and your coding agent</dd></div>
            <div><dt class="label">To</dt><dd class="big">The App Store</dd></div>
            <div><dt class="label">Contents</dt><dd>{n(count, "skill")} · {n(PLUGINS.length, "plugin")} · {n(GUIDES.length, "guide")}</dd></div>
            <div><dt class="label">Postage</dt><dd>$99 a year to Apple. A backend from €5 a month, if you need one.</dd></div>
            <div><dt class="label">Handling</dt><dd>No AWS. No Kubernetes. No purple gradients.</dd></div>
          </dl>
          <div class="barcode" aria-hidden="true">
            {Array.from({ length: 46 }, (_, i) => (
              <i style={`--w:${[1, 3, 1, 2, 1, 1, 4, 1, 2, 3][i % 10]}px`} />
            ))}
          </div>
          <span class="stamp" aria-hidden="true">Free<br />MIT</span>
        </aside>
      </div>
    </section>

    <!-- ============ START: three steps + the picker ============ -->
    <section id="start" class="start">
      <div class="wrap">
        <header class="section-head">
          <h2 class="display h2">Three steps</h2>
          <p class="muted">Not every app needs a server, a paywall or a landing page. Answer a few questions and take only what yours needs.</p>
        </header>
        <ol class="steps">
          <li>
            <span class="step-n" aria-hidden="true">1</span>
            <div>
              <h3>Add the skills to your agent</h3>
              <p>Claude Code: paste the lines from your cart below. Codex, Cursor, Gemini CLI and others: <code>npx skills add {REPO_SLUG}</code>.</p>
            </div>
          </li>
          <li>
            <span class="step-n" aria-hidden="true">2</span>
            <div>
              <h3>Run the plan in your app’s folder</h3>
              <p>Copy the prompt from your cart. It carries your answers, checks what your app already has, and writes <code>PLAN.md</code>. <a href="/example-plan/">See an example</a>.</p>
            </div>
          </li>
          <li>
            <span class="step-n" aria-hidden="true">3</span>
            <div>
              <h3>Work down the plan</h3>
              <p>Skills do the work. <a href="/guides/">Guides</a> cover the clicks only you can make. Stuck? <a href="/guides/when-you-are-stuck/">Here is how to get unstuck</a>, or <a href="#help">ask me</a>.</p>
            </div>
          </li>
        </ol>
        <Picker />
      </div>
    </section>

    <!-- ============ ROUTE MAP ============ -->
    <section id="route" class="route">
      <div class="wrap">
        <header class="section-head">
          <h2 class="display h2">The route</h2>
          <p class="muted">Where each part lives, and what carries your app from your Mac to a phone. No backend? Skip the box.</p>
        </header>
        <RouteMap />
      </div>
    </section>

    <!-- ============ WHAT'S IN THE BOX ============ -->
    <section id="contents" class="packing">
      <div class="wrap">
        <header class="section-head">
          <h2 class="display h2">What’s in the box</h2>
          <p class="muted">
            Every skill, grouped by plugin. A skill is a set of instructions your agent follows, like
            <code>/ship-ios:app-store-ready</code>. You install a plugin, not a skill.
            <a href="#start">The planner</a> tells you which plugins your app needs.
          </p>
        </header>

        {PLUGINS.map((p) => (
          <details class="compartment">
            <summary class="comp-head">
              <span class="comp-letter" aria-hidden="true">{p.letter}</span>
              <div>
                <h3 class="comp-title">{p.title} <span class="label">{p.id}</span></h3>
                <p class="comp-blurb">{p.blurb}</p>
              </div>
              <span class="label runs">{n(skillsFor(p.id).length, "skill")} · {p.runsOn}</span>
            </summary>
            <ol class="items">
              {skillsFor(p.id).map((s, i) => (
                <li>
                  <span class="label qty">{String(i + 1).padStart(2, "0")}</span>
                  <code class="skill">/{p.id}:{s.name}</code>
                  <span class="line">{s.line}</span>
                </li>
              ))}
            </ol>
          </details>
        ))}
      </div>
    </section>

    <!-- ============ GOOD COMPANY ============ -->
    <section id="others" class="others">
      <div class="wrap">
        <header class="section-head">
          <h2 class="display h2">Good company</h2>
          <p class="muted">Skills by other people that I use next to these. Not mine. Each has its own install steps and licence.</p>
        </header>
        <ul class="other-list">
          {OTHERS.map((o) => (
            <li>
              <a class="other-name" href={o.url}>{o.name} ↗</a>
              <span class="label other-by">{o.by}</span>
              <span class="line">{o.line}</span>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- ============ THE BILL ============ -->
    <section class="bill-section">
      <div class="wrap bill-grid">
        <div class="bill-copy">
          <h2 class="display h2">Need a backend? One box is enough.</h2>
          <p>
            Many apps need no server at all. If yours does, you don’t need AWS for your first thousand users.
            One machine runs the API, the database and the landing page. Cloudflare Tunnel puts it on the
            internet without opening a port. Your Mac builds the app for free. When one box is not enough,
            you will know, and you will have users to pay for the next one.
          </p>
          <div class="skip">
            <p class="label skip-head">Subscriptions you can skip for now</p>
            <ul>
              {SKIPPABLE.map((x) => (
                <li>
                  <span class="skip-what">{x.what} <small>({x.example})</small></span>
                  <span class="skip-instead">→ {x.instead}</span>
                </li>
              ))}
            </ul>
            <p class="skip-note">
              These are good products, and they save time. Together they cost about ${skipTotal} a month
              before you know if anyone wants your app. Test the idea first. Pay for comfort when users
              make it worth it. Free tiers have limits: Vercel’s is for non-commercial use, Supabase
              pauses a free project after a week without traffic, and PlanetScale has no free tier.
            </p>
          </div>
        </div>
        <figure class="receipt" aria-label="Monthly cost">
          <p class="label receipt-head">Receipt · one app with a backend</p>
          <ul>
            {bill.map((b) => (
              <li>
                <span>{b.item}</span>
                <span class="dots" aria-hidden="true"></span>
                <span class="cost">{b.cost}{b.per && <small> / {b.per}</small>}</span>
              </li>
            ))}
          </ul>
          <p class="total"><span>Total</span><span>≈ €14 a month</span></p>
          <p class="label receipt-foot">Apple’s fee spread over 12 months. Your Claude plan not included.</p>
        </figure>
      </div>
    </section>

    <!-- ============ CARE ============ -->
    <section id="care" class="care">
      <div class="wrap">
        <header class="section-head">
          <h2 class="display h2">One box needs a little care.</h2>
          <p class="muted">About 15 minutes a month. An agent does the work over SSH with the box skills. You read what it found and say yes.</p>
        </header>
        <div class="care-grid">
          <div>
            <p class="label">What it asks of you</p>
            <ul class="care-list">
              <li>Security updates install themselves. Reboot when the box says a reboot is pending.</li>
              <li>Once a month, and after any change, ask your agent to “check the box”. The check must end with 0 fail.</li>
              <li>Update Traefik, Postgres and your images a few times a year. Read the release notes first.</li>
              <li>Make sure last night’s backup ran. Restore one once, so you know it works.</li>
              <li>Watch the disk. Docker images and logs grow.</li>
            </ul>
          </div>
          <div>
            <p class="label">When to go further</p>
            <ul class="care-list">
              <li>One box is one point of failure. If it dies, the app is down until you restore it. At home, a power cut or an internet outage takes it down too.</li>
              <li>Move on when downtime costs you money or trust: a second server, a managed database with point-in-time recovery, and monitoring that wakes you up.</li>
              <li>A big app, sensitive data such as health or children’s data, or a team: plan a larger setup from the start, and get advice.</li>
            </ul>
          </div>
        </div>
      </div>
    </section>

    <!-- ============ PROOF ============ -->
    <section class="proof">
      <div class="wrap">
        <header class="section-head">
          <h2 class="display h2">Shipped this way</h2>
          <p class="muted">Solo, at night, next to a full-time job. Same skills, same box.</p>
        </header>
        <div class="about">
          <p>
            I’m <strong>Geir-Stian Løkkesveen</strong>, in Norway. I have a day job and a family, and I ship
            iOS apps at night with Claude Code, and I test the skills there. They are plain
            <code>SKILL.md</code> files, so Codex, Cursor, Gemini CLI and other agents can use them too.
            My first app went out in 2019. Three of the apps below
            are on the App Store today. Download one and see for yourself.
          </p>
          <p class="about-links">
            <a href="mailto:geir@lokkesveen.com">geir@lokkesveen.com</a>
            <a href="https://github.com/ggi3201">GitHub ↗</a>
          </p>
        </div>
        <ul class="apps">
          {APPS.map((a) => (
            <li>
              <span class="app-name">{a.name}</span>
              <span class="app-what">{a.what}</span>
              {a.url
                ? <a class="app-status" href={a.url}>{a.status} ↗</a>
                : <span class="app-status soon">{a.status}</span>}
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- ============ HELP ============ -->
    <section id="help" class="help">
      <div class="wrap help-grid">
        <div>
          <p class="kicker signal">Stuck on the last mile?</p>
          <h2 class="display h2">I can help you get it live.</h2>
        </div>
        <div class="help-body">
          <p>
            I help you get your Expo app onto TestFlight and submitted to App Review. Apple makes the final
            call on approval. You keep your own Apple account
            and your own server. I set them up with you and hand them over.
          </p>
          <ol class="how">
            <li><strong>You write.</strong> Send a link to the app or the repo, and where you are stuck.</li>
            <li><strong>I quote.</strong> One fixed price for the whole job, before any work starts.</li>
            <li><strong>We ship.</strong> I do the work on your accounts, and you get notes on every step.</li>
          </ol>
          <p class="small">
            The first three launches get a reduced price, in return for a short case study.
          </p>
          <a class="btn" href={mailto}>Write to me <span aria-hidden="true">→</span></a>
        </div>
      </div>
    </section>

  </main>
</Base>

<style>
  section { padding-block: clamp(56px, 9vw, 112px); }
  .muted { color: var(--ink-2); margin: 0; }
  code { font-family: var(--mono); font-size: 0.86em; }

  /* hero */
  .hero { padding-block: clamp(40px, 7vw, 96px) clamp(48px, 8vw, 104px); }
  .hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr);
    gap: clamp(32px, 5vw, 72px);
    align-items: center;
  }
  .hero-title { font-size: clamp(2.4rem, 5.4vw, 4.7rem); margin-block: 14px 26px; }
  .hero-title span { display: inline-block; }
  .lede { font-size: clamp(1.15rem, 1.6vw, 1.32rem); max-width: 34em; color: var(--ink-2); margin: 0; }
  .lede code { background: var(--code-bg); padding: 1px 6px; color: var(--ink); }
  .hero-actions { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 32px; }

  .label-card {
    position: relative;
    border: 2px solid var(--ink);
    background: var(--paper);
    box-shadow: 10px 10px 0 var(--paper-3);
    padding: 0;
  }
  .label-head {
    display: flex; justify-content: space-between; align-items: center;
    padding: 12px 16px; background: var(--ink); color: var(--paper);
  }
  .label-head .label { color: var(--paper); opacity: 0.7; }
  .label-rows { margin: 0; }
  .label-rows > div {
    display: grid; grid-template-columns: 92px 1fr; gap: 12px;
    padding: 12px 16px; border-bottom: 1px solid var(--ink);
    animation: print 520ms cubic-bezier(.2,.8,.2,1) both;
  }
  .label-rows > div:nth-child(1) { animation-delay: 120ms; }
  .label-rows > div:nth-child(2) { animation-delay: 220ms; }
  .label-rows > div:nth-child(3) { animation-delay: 320ms; }
  .label-rows > div:nth-child(4) { animation-delay: 420ms; }
  .label-rows > div:nth-child(5) { animation-delay: 520ms; }
  .label-rows dt { padding-top: 3px; }
  .label-rows dd { margin: 0; font-family: var(--display); font-stretch: 100%; font-weight: 500; font-size: 1rem; line-height: 1.3; }
  .label-rows dd.big { font-stretch: 125%; font-weight: 800; font-size: clamp(1.5rem, 2.6vw, 2rem); letter-spacing: -0.02em; line-height: 1; }
  .barcode { display: flex; gap: 2px; height: 46px; padding: 12px 16px; align-items: stretch; }
  .barcode i { width: var(--w); background: var(--ink); }
  .stamp {
    position: absolute; right: 18px; bottom: 16px;
    border: 2.5px solid var(--signal); color: var(--signal);
    font-family: var(--display); font-stretch: 125%; font-weight: 800;
    font-size: 0.82rem; line-height: 1.05; letter-spacing: 0.08em; text-transform: uppercase; text-align: center;
    padding: 6px 10px; background: var(--paper);
    transform: rotate(-8deg);
    animation: stamp 420ms cubic-bezier(.2,.8,.2,1) 820ms both;
  }


  /* start */
  .start { border-top: 1px solid var(--rule); }
  .steps { list-style: none; margin: 0 0 clamp(32px, 5vw, 56px); padding: 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 16px; }
  .steps li { display: grid; grid-template-columns: auto 1fr; gap: 14px; padding: 18px; border: 2px solid var(--ink); }
  .step-n {
    display: grid; place-items: center; width: 40px; height: 40px; border-radius: 50%;
    border: 2.5px solid var(--signal); color: var(--signal);
    font-family: var(--display); font-stretch: 125%; font-weight: 800; font-size: 1.2rem;
  }
  .steps h3 { margin: 4px 0 6px; font-family: var(--display); font-stretch: 112%; font-weight: 700; font-size: 1.12rem; line-height: 1.25; }
  .steps h3 code, .steps p code { font-family: var(--mono); font-size: 0.85em; }
  .steps p { margin: 0; color: var(--ink-2); font-size: 1.02rem; }

  /* sections */
  .section-head { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: 8px 32px; margin-bottom: clamp(28px, 4vw, 48px); }
  .h2 { font-size: clamp(2rem, 4.6vw, 3.6rem); }
  .section-head .muted { max-width: 36ch; }

  /* what's in the box */
  .compartment { border-top: 2px solid var(--ink); }
  .compartment:last-of-type { border-bottom: 2px solid var(--ink); }
  .comp-head {
    display: grid; grid-template-columns: auto 1fr auto auto; gap: 18px; align-items: center;
    padding-block: 18px; cursor: pointer; list-style: none;
  }
  .comp-head::-webkit-details-marker { display: none; }
  .comp-head::after {
    content: "+"; font-family: var(--display); font-weight: 800; font-size: 1.6rem; line-height: 1;
    width: 1ch; text-align: center; transition: transform 160ms cubic-bezier(.2,.8,.2,1);
  }
  .compartment[open] .comp-head::after { transform: rotate(45deg); color: var(--signal); }
  .comp-head:hover .comp-title { text-decoration: underline; text-decoration-color: var(--signal); text-decoration-thickness: 2px; text-underline-offset: 0.2em; }
  .compartment .items { padding-bottom: 14px; }
  .comp-letter {
    display: grid; place-items: center; width: 48px; height: 48px;
    border: 2px solid var(--ink);
    font-family: var(--display); font-stretch: 125%; font-weight: 800; font-size: 1.5rem;
  }
  .comp-title { margin: 0; font-family: var(--display); font-stretch: 112%; font-weight: 700; font-size: 1.35rem; display: flex; align-items: baseline; gap: 12px; flex-wrap: wrap; }
  .comp-title .label { text-transform: none; letter-spacing: 0.02em; }
  .comp-blurb { margin: 2px 0 0; color: var(--ink-2); }
  .runs { white-space: nowrap; }
  .items { list-style: none; margin: 0; padding: 0; }
  .items li {
    position: relative;
    display: grid; grid-template-columns: 40px minmax(200px, 300px) 1fr; gap: 16px; align-items: baseline;
    padding: 12px 0 12px 0; border-bottom: 1px dashed var(--rule);
    transition: padding 160ms cubic-bezier(.2,.8,.2,1);
  }
  .items li::before {
    content: ""; position: absolute; left: -14px; top: 12px; bottom: 12px; width: 3px;
    background: var(--signal); transform: scaleY(0); transform-origin: top; transition: transform 180ms cubic-bezier(.2,.8,.2,1);
  }
  .items li:hover::before { transform: scaleY(1); }
  .skill { font-family: var(--mono); font-size: 0.92rem; font-weight: 500; }
  .line { color: var(--ink-2); }

  /* good company */
  .others { padding-top: 0; }
  .other-list { list-style: none; margin: 0; padding: 0; border-top: 2px solid var(--ink); }
  .other-list li {
    display: grid; grid-template-columns: minmax(150px, 220px) minmax(110px, 160px) 1fr; gap: 4px 20px; align-items: baseline;
    padding: 14px 0; border-bottom: 1px dashed var(--rule);
  }
  .other-name { font-family: var(--mono); font-size: 0.95rem; font-weight: 500; }
  .other-by { text-transform: none; letter-spacing: 0.02em; }

  /* skip list */
  .skip { margin-top: 30px; max-width: 46ch; }
  .bill-copy .skip-head { margin: 0 0 8px; font-size: 0.72rem; color: color-mix(in oklab, var(--paper) 70%, transparent); }
  .skip ul { list-style: none; margin: 0; padding: 0; border-top: 1px solid color-mix(in oklab, var(--paper) 30%, transparent); }
  .skip li { display: grid; gap: 2px; padding: 10px 0; border-bottom: 1px dashed color-mix(in oklab, var(--paper) 25%, transparent); }
  .skip-what { font-size: 1.05rem; }
  .skip-what small { color: color-mix(in oklab, var(--paper) 60%, transparent); font-size: 0.85em; }
  .skip-instead { font-family: var(--mono); font-size: 0.82rem; color: var(--signal); }
  .bill-copy .skip-note { font-size: 1rem; margin-top: 14px; }

  /* bill */
  .bill-section { background: var(--ink); color: var(--paper); }
  .bill-section a:hover { color: var(--signal); }
  .bill-grid { display: grid; grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr); gap: clamp(32px, 6vw, 80px); align-items: start; }
  .bill-copy p { color: color-mix(in oklab, var(--paper) 78%, transparent); max-width: 40ch; margin: 22px 0 0; font-size: 1.2rem; }
  .receipt {
    margin: 0; background: var(--paper); color: var(--ink); padding: 22px 22px 18px;
    font-family: var(--mono); font-size: 0.86rem;
    transform: rotate(1.2deg);
    -webkit-mask: radial-gradient(circle 6px at 50% 0, #0000 98%, #000) 50% 0 / 16px 100% repeat-x,
                  radial-gradient(circle 6px at 50% 100%, #0000 98%, #000) 50% 100% / 16px 100% repeat-x;
    -webkit-mask-composite: source-in; mask-composite: intersect;
  }
  .receipt-head { margin: 4px 0 14px; text-align: center; }
  .receipt ul { list-style: none; margin: 0; padding: 0; }
  .receipt li { display: grid; grid-template-columns: auto 1fr auto; gap: 8px; align-items: baseline; padding: 6px 0; }
  .receipt li > span:first-child { font-family: var(--text); font-size: 1rem; }
  .dots { border-bottom: 1px dotted var(--ink-3); transform: translateY(-4px); min-width: 12px; }
  .cost { text-align: right; white-space: nowrap; }
  .cost small { color: var(--ink-3); font-size: 0.78em; }
  .total { display: flex; justify-content: space-between; margin: 12px 0 0; padding-top: 12px; border-top: 2px solid var(--ink); font-weight: 500; font-size: 1rem; }
  .receipt-foot { margin: 14px 0 6px; text-align: center; text-transform: none; letter-spacing: 0.02em; }

  /* care */
  .care-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 24px clamp(32px, 6vw, 80px); }
  .care-grid .label { margin: 0 0 8px; }
  .care-list { list-style: none; margin: 0; padding: 0; border-top: 2px solid var(--ink); }
  .care-list li { padding: 12px 0 12px 22px; border-bottom: 1px dashed var(--rule); position: relative; font-size: 1.05rem; color: var(--ink-2); }
  .care-list li::before { content: ""; position: absolute; left: 2px; top: 20px; width: 8px; height: 8px; border: 1.5px solid var(--signal); }

