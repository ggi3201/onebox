---
import Base from "../layouts/Base.astro";
import Picker from "../components/Picker.astro";
import { PLUGINS, SKILLS, skillsFor, APPS, REPO, REPO_SLUG, OTHERS } from "../data/kit";
import { GUIDES } from "../data/guides";
import catalog from "../../../plugins/start/skills/plan/references/catalog.json";

// The example chat uses the plan's real nudge lines, so it says what the agent says.
const nudge = (id: string) => {
  const line = (catalog.items as { id: string; nudge?: string }[]).find((i) => i.id === id)?.nudge;
  if (!line) throw new Error(`catalog.json has no nudge for "${id}"`);
  return line;
};
const chat = { repo: nudge("new-app"), secrets: nudge("secrets"), apple: nudge("sign-in-with-apple") };
const audience = [
  { tag: "Yes", yes: true, text: "A developer who has never shipped an iOS app, and wants the whole road in one place: signing, TestFlight, the store page and App Review." },
  { tag: "Yes", yes: true, text: "Someone who already ships, and wants the repeatable parts done the same way every time." },
  { tag: "Not yet", yes: false, text: "Someone who has never used a terminal. The skills explain each step, but they assume you can run a command and read an error." },
  { tag: "Not covered", yes: false, text: "Android and the Play Store. iOS only for now." },
];
const road = [
  { tag: "1 · Apple", text: "Join the Apple Developer Program ($99 a year) and install Xcode. The guides show the clicks only you can make.", skills: [] },
  { tag: "2 · TestFlight", text: "Build on your own Mac, for free, and upload. Testers install it from TestFlight.", skills: ["expo-local-build", "appstore-connect"] },
  { tag: "3 · Your phone", text: "Put a test build on your own iPhone, without TestFlight.", skills: ["ios-preview-build"] },
  { tag: "4 · Store page", text: "The icon, screenshots from real screens, and text that search finds. Apple also wants a privacy policy and a support page.", skills: ["draw-app-icon", "app-store-screenshots", "store-listing"] },
  { tag: "5 · App Review", text: "Find what Apple will reject before Apple does. Then fill in the version page and submit.", skills: ["app-store-ready", "appstore-connect"] },
  { tag: "6 · Updates", text: "Ship a JavaScript fix without App Review, and every version after the first.", skills: ["eas-update"] },
];
const pluginOf = (name: string) => {
  const s = SKILLS.find((x) => x.name === name);
  if (!s) throw new Error(`kit.ts has no skill "${name}"`);
  return s.plugin;
};
const tested = [
  { tag: "Tested", yes: true, text: "A new app from an empty folder, with the skills and guides only." },
  { tag: "Tested", yes: true, text: "The three layouts (.NET API, Node API, no server), each end to end in the iOS Simulator." },
  { tag: "Fixed", yes: true, text: "Every problem those runs found became an issue and a fix." },
  { tag: "Not yet", yes: false, text: "A clean Mac with nothing installed." },
  { tag: "Not yet", yes: false, text: "A person who is new to all of it." },
];

const count = SKILLS.length;
const n = (k: number, word: string) => `${k} ${word}${k === 1 ? "" : "s"}`;
const mailto =
  "mailto:geir@lokkesveen.com?subject=" +
  encodeURIComponent("Get my app live") +
  "&body=" +
  encodeURIComponent(
    "The app (link or repo):\n\nWhat works now:\n\nWhere I am stuck:\n\nTestFlight or the App Store:\n\nWhen I want it live:\n",
  );
---

<Base
  title="onebox — get your app on the App Store"
  description="Free agent skills and plain guides for getting an Expo app onto the App Store: signing, TestFlight, the store page and App Review."
>
  <main>
    <!-- ============ HERO ============ -->
    <section class="hero">
      <div class="wrap hero-grid">
        <div class="hero-copy">
          <p class="kicker">Agent skills · Expo · iOS</p>
          <h1 class="display hero-title"><span>Get your app</span> <span>on the</span> <span>App Store.</span></h1>
          <p class="lede">
            You built something with Claude Code, Codex or Cursor. It works on your phone. Then come signing,
            TestFlight, the store page and App Review.
            These skills and guides take you the rest of the way.
          </p>
          <div class="hero-actions">
            <a class="btn" href="#start">Start in three steps <span aria-hidden="true">↓</span></a>
            <a class="btn ghost" href="#help">Or ask me for help</a>
          </div>
        </div>

      </div>
    </section>

    <!-- ============ WHAT IT FEELS LIKE: the example chat ============ -->
    <section id="feel" class="feel">
      <div class="wrap feel-grid">
        <div class="feel-copy">
          <h2 class="display h2">What it feels like</h2>
          <p class="feel-lede">
            You tell your coding agent your idea. It makes the repo, checks your Mac, and then walks you
            through the rest one step at a time. Each step is one question. “Yes” is enough to go on.
          </p>
          <p class="muted">
            No checklist to read first. The agent checks what your Mac and your app already have. It speaks
            up only when something blocks the next step, and then only about that one thing. The full plan is
            in <code>PLAN.md</code> if you want it. <a href="/example-plan/">See an example</a>.
          </p>
        </div>
        <figure class="chat" aria-label="An example chat with a coding agent">
          <figcaption class="chat-head">
            <span class="kicker">Your coding agent</span>
            <span class="label">Example</span>
          </figcaption>
          <ol class="turns">
            <li class="you"><span class="who label">You</span><p>I have an idea for an iPhone app: a warranty keeper.</p></li>
            <li class="agent"><span class="who label">Agent</span><p>Next: <strong class="nudge">{chat.repo}</strong>. Continue?</p></li>
            <li class="you"><span class="who label">You</span><p>yes</p></li>
            <li class="agent">
              <span class="who label">Agent</span>
              <p><span class="done">Done: your app runs in the Simulator.</span> Next: <strong class="nudge">{chat.secrets}</strong>. Continue?</p>
            </li>
            <li class="you"><span class="who label">You</span><p>yes</p></li>
            <li class="agent">
              <span class="who label">Agent</span>
              <p>
                Next: <strong class="nudge">{chat.apple}</strong>. This part is yours: turn it on for your app in
                your Apple Developer account (2 minutes, I will show you where). Ready when you are.
              </p>
            </li>
          </ol>
        </figure>
      </div>
    </section>

    <!-- ============ WHO IT IS FOR ============ -->
    <section id="who" class="who-section">
      <div class="wrap">
        <header class="section-head">
          <h2 class="display h2">Who it is for</h2>
          <p class="muted">Who gets the most out of it, and who does not yet.</p>
        </header>
        <ul class="tag-list">
          {audience.map((a) => (
            <li>
              <span class:list={["tag", { no: !a.yes }]}>{a.tag}</span>
              <span class="line">{a.text}</span>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- ============ START: three steps + the picker ============ -->
    <section id="start" class="start">
      <div class="wrap">
        <header class="section-head">
          <h2 class="display h2">Three steps</h2>
          <p class="muted">Not every app needs a server, a paywall or a landing page. Answer a few questions and take only what yours needs. iOS only, for now.</p>
        </header>
        <ol class="steps">
          <li>
            <span class="step-n" aria-hidden="true">1</span>
            <div>
              <h3>Add the skills to your agent</h3>
              <p>Claude Code: paste the lines from your cart below. Codex: <code>codex plugin marketplace add {REPO_SLUG}</code>, then <code>codex plugin add start@onebox</code>. Cursor, Gemini CLI and others: <code>npx skills add {REPO_SLUG}</code>.</p>
            </div>
          </li>
          <li>
            <span class="step-n" aria-hidden="true">2</span>
            <div>
              <h3>Run the plan in your app’s folder</h3>
              <p>Copy the prompt from your cart. It carries your answers, checks what your app already has, and writes <code>PLAN.md</code>. <a href="/example-plan/">See an example</a>.</p>
            </div>
          </li>
          <li>
            <span class="step-n" aria-hidden="true">3</span>
            <div>
              <h3>Work down the plan</h3>
              <p>Skills do the work. <a href="/guides/">Guides</a> cover the clicks only you can make. Stuck? <a href="/guides/when-you-are-stuck/">Here is how to get unstuck</a>, or <a href="#help">ask me</a>.</p>
            </div>
          </li>
        </ol>
        <Picker />
      </div>
    </section>

    <!-- ============ THE ROAD ============ -->
    <section id="route" class="route">
      <div class="wrap">
        <header class="section-head">
          <h2 class="display h2">The road to the App Store</h2>
          <p class="muted">What happens between “it works on my phone” and “it is on the App Store”, and the skill for each part.</p>
        </header>
        <ol class="tag-list road">
          {road.map((r) => (
            <li>
              <span class="tag">{r.tag}</span>
              <span class="line">{r.text}{r.skills.length > 0 && <span class="road-skills">{r.skills.map((k) => <code>/{pluginOf(k)}:{k}</code>)}</span>}</span>
            </li>
          ))}
        </ol>
        <p class="muted road-note">Most apps need no server. If yours does, the <code>box</code> plugin runs the API, the database and a landing page on one cheap machine.</p>
      </div>
    </section>

    <!-- ============ WHAT'S IN THE BOX ============ -->
    <section id="contents" class="packing">
      <div class="wrap">
        <header class="section-head">
          <h2 class="display h2">What’s in the box</h2>
          <p class="muted">
            Every skill, grouped by plugin. A skill is a set of instructions your agent follows,
            like <code>/ship-ios:app-store-ready</code>. You install a plugin, not a skill. 
            <a href="#start">The planner</a> tells you which plugins your app needs.
          </p>
        </header>

        {PLUGINS.map((p) => (
          <details class="compartment">
            <summary class="comp-head">
              <span class="comp-letter" aria-hidden="true">{p.letter}</span>
              <div>
                <h3 class="comp-title">{p.title} <span class="label">{p.id}</span></h3>
                <p class="comp-blurb">{p.blurb}</p>
              </div>
              <span class="label runs">{n(skillsFor(p.id).length, "skill")} · {p.runsOn}</span>
            </summary>
            <ol class="items">
              {skillsFor(p.id).map((s, i) => (
                <li>
                  <span class="label qty">{String(i + 1).padStart(2, "0")}</span>
                  <code class="skill">/{p.id}:{s.name}</code>
                  <span class="line">{s.line}</span>
                </li>
              ))}
            </ol>
          </details>
        ))}
      </div>
    </section>

    <!-- ============ PROOF ============ -->
    <section class="proof">
      <div class="wrap">
        <header class="section-head">
          <h2 class="display h2">Apps I have shipped</h2>
          <p class="muted">The skills come from building and releasing these.</p>
        </header>
        <div class="about">
          <p>
            I’m <strong>Geir-Stian Løkkesveen</strong>, based in Norway. I build iOS apps next to a day job.
            I have shipped three and got every one through App Review. Getting people to download them
            is a different skill, and not one I have. So this kit is about the part I am good at:
            getting your app onto the App Store. I use Claude Code.
            The skills are plain <code>SKILL.md</code> files, so Codex, Cursor and other agents can use them too.
          </p>
          <p class="about-links">
            <a href="mailto:geir@lokkesveen.com">geir@lokkesveen.com</a>
            <a href="https://github.com/ggi3201">GitHub ↗</a>
            <a href="https://chewable.app">My apps: chewable.app ↗</a>
          </p>
        </div>
        <ul class="apps">
          {APPS.map((a) => (
            <li>
              <a class="app-name" href={a.site}>{a.name}</a>
              <span class="app-what">{a.what}</span>
              {a.url
                ? <a class="app-status" href={a.url}>{a.status} ↗</a>
                : <span class="app-status soon">{a.status}</span>}
            </li>
          ))}
        </ul>

        <div id="tested" class="tested">
          <div class="tested-copy">
            <h3 class="display h3">How well tested is it</h3>
            <p>
              onebox comes from shipping real apps, and I keep testing it on new ones.
              Not every path has had a real test yet. This is where it stands.
            </p>
            <p class="muted">
              <a href={`${REPO}/blob/main/docs/clean-user-test.md`}>The script for the new-user test ↗</a> is on GitHub.
              If you try it, <a href={`${REPO}/issues/new?template=dogfood.md`}>tell me where you got stuck ↗</a>.
            </p>
          </div>
          <ul class="tag-list">
            {tested.map((t) => (
              <li>
                <span class:list={["tag", { no: !t.yes }]}>{t.tag}</span>
                <span class="line">{t.text}</span>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </section>

    <!-- ============ HELP ============ -->
    <section id="help" class="help">
      <div class="wrap help-grid">
        <div>
          <p class="kicker signal">Stuck on the last mile?</p>
          <h2 class="display h2">I can help you get it live.</h2>
        </div>
        <div class="help-body">
          <p>
            I help you get your Expo app onto TestFlight and submitted to App Review. Apple makes the final
            call on approval. You keep your own Apple account
            and your own server. I set them up with you and hand them over.
          </p>
          <ol class="how">
            <li><strong>You write.</strong> Send a link to the app or the repo, and where you are stuck.</li>
            <li><strong>I quote.</strong> One fixed price for the whole job, before any work starts.</li>
            <li><strong>We ship.</strong> I do the work on your accounts, and you get notes on every step.</li>
          </ol>
          <p class="small">
            The first three launches get a reduced price, in return for a short case study.
          </p>
          <a class="btn" href={mailto}>Write to me <span aria-hidden="true">→</span></a>
        </div>
      </div>
    </section>


    <!-- ============ GOOD COMPANY ============ -->
    <section id="others" class="others">
      <div class="wrap">
        <header class="section-head">
          <h2 class="display h2">Good company</h2>
          <p class="muted">Skills by other people that I use next to these. Not mine. Each has its own install steps and licence.</p>
        </header>
        <ul class="other-list">
          {OTHERS.map((o) => (
            <li>
              <a class="other-name" href={o.url}>{o.name} ↗</a>
              <span class="label other-by">{o.by}</span>
              <span class="line">{o.line}</span>
            </li>
          ))}
        </ul>
      </div>
    </section>
  </main>
</Base>

<style>
  section { padding-block: clamp(56px, 9vw, 112px); }
  .muted { color: var(--ink-2); margin: 0; }
  code { font-family: var(--mono); font-size: 0.86em; }

  /* the road */
  .road-skills { display: flex; flex-wrap: wrap; gap: 6px 12px; margin-top: 6px; }
  .road-skills code { font-family: var(--mono); font-size: 0.82rem; color: var(--signal); }
  .road-note { margin-top: 18px; }

  /* hero */
  .hero { padding-block: clamp(40px, 7vw, 96px) clamp(48px, 8vw, 104px); }
  .hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
  }
  .hero-title { font-size: clamp(2.4rem, 5.4vw, 4.7rem); margin-block: 14px 26px; }
  .hero-title span { display: inline-block; }
  .lede { font-size: clamp(1.15rem, 1.6vw, 1.32rem); max-width: 34em; color: var(--ink-2); margin: 0; }
  .lede code { background: var(--code-bg); padding: 1px 6px; color: var(--ink); }
  .hero-actions { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 32px; }



  /* start */
  .start { border-top: 1px solid var(--rule); }
  .steps { list-style: none; margin: 0 0 clamp(32px, 5vw, 56px); padding: 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 16px; }
  .steps li { display: grid; grid-template-columns: auto 1fr; gap: 14px; padding: 18px; border: 2px solid var(--ink); }
  .step-n {
    display: grid; place-items: center; width: 40px; height: 40px; border-radius: 50%;
    border: 2.5px solid var(--signal); color: var(--signal);
    font-family: var(--display); font-stretch: 125%; font-weight: 800; font-size: 1.2rem;
  }
  .steps h3 { margin: 4px 0 6px; font-family: var(--display); font-stretch: 112%; font-weight: 700; font-size: 1.12rem; line-height: 1.25; }
  .steps h3 code, .steps p code { font-family: var(--mono); font-size: 0.85em; }
  .steps p { margin: 0; color: var(--ink-2); font-size: 1.02rem; }

  /* sections */
  .section-head { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: 8px 32px; margin-bottom: clamp(28px, 4vw, 48px); }
  .h2 { font-size: clamp(2rem, 4.6vw, 3.6rem); }
  .section-head .muted { max-width: 36ch; }

  /* what's in the box */
  .compartment { border-top: 2px solid var(--ink); }
  .compartment:last-of-type { border-bottom: 2px solid var(--ink); }
  .comp-head {
    display: grid; grid-template-columns: auto 1fr auto auto; gap: 18px; align-items: center;
    padding-block: 18px; cursor: pointer; list-style: none;
  }
  .comp-head::-webkit-details-marker { display: none; }
  .comp-head::after {
    content: "+"; font-family: var(--display); font-weight: 800; font-size: 1.6rem; line-height: 1;
    width: 1ch; text-align: center; transition: transform 160ms cubic-bezier(.2,.8,.2,1);
  }
  .compartment[open] .comp-head::after { transform: rotate(45deg); color: var(--signal); }
  .comp-head:hover .comp-title { text-decoration: underline; text-decoration-color: var(--signal); text-decoration-thickness: 2px; text-underline-offset: 0.2em; }
  .compartment .items { padding-bottom: 14px; }
  .comp-letter {
    display: grid; place-items: center; width: 48px; height: 48px;
    border: 2px solid var(--ink);
    font-family: var(--display); font-stretch: 125%; font-weight: 800; font-size: 1.5rem;
  }
  .comp-title { margin: 0; font-family: var(--display); font-stretch: 112%; font-weight: 700; font-size: 1.35rem; display: flex; align-items: baseline; gap: 12px; flex-wrap: wrap; }
  .comp-title .label { text-transform: none; letter-spacing: 0.02em; }
  .comp-blurb { margin: 2px 0 0; color: var(--ink-2); }
  .runs { white-space: nowrap; }
  .items { list-style: none; margin: 0; padding: 0; }
  .items li {
    position: relative;
    display: grid; grid-template-columns: 40px minmax(200px, 300px) 1fr; gap: 16px; align-items: baseline;
    padding: 12px 0 12px 0; border-bottom: 1px dashed var(--rule);
    transition: padding 160ms cubic-bezier(.2,.8,.2,1);
  }
  .items li::before {
    content: ""; position: absolute; left: -14px; top: 12px; bottom: 12px; width: 3px;
    background: var(--signal); transform: scaleY(0); transform-origin: top; transition: transform 180ms cubic-bezier(.2,.8,.2,1);
  }
  .items li:hover::before { transform: scaleY(1); }
  .skill { font-family: var(--mono); font-size: 0.92rem; font-weight: 500; }
  .line { color: var(--ink-2); }

  /* good company */
  .other-list { list-style: none; margin: 0; padding: 0; border-top: 2px solid var(--ink); }
  .other-list li {
    display: grid; grid-template-columns: minmax(150px, 220px) minmax(110px, 160px) 1fr; gap: 4px 20px; align-items: baseline;
    padding: 14px 0; border-bottom: 1px dashed var(--rule);
  }
  .other-name { font-family: var(--mono); font-size: 0.95rem; font-weight: 500; }
  .other-by { text-transform: none; letter-spacing: 0.02em; }

  /* proof */
  .apps { list-style: none; margin: 0; padding: 0; border-top: 2px solid var(--ink); }
  .apps li { display: grid; grid-template-columns: minmax(120px, 220px) 1fr auto; gap: 8px 24px; align-items: baseline; padding: 18px 0; border-bottom: 1px solid var(--rule); }
  .app-name { font-family: var(--display); font-stretch: 125%; font-weight: 800; font-size: clamp(1.4rem, 2.6vw, 2rem); letter-spacing: -0.02em; }
  a.app-name { color: inherit; text-decoration: none; }
  a.app-name:hover { text-decoration: underline; text-underline-offset: 4px; }
  .app-what { color: var(--ink-2); }
  .app-status { font-family: var(--mono); font-size: 0.8rem; text-transform: uppercase; letter-spacing: 0.06em; white-space: nowrap; }
  .app-status.soon { color: var(--ink-3); }

  /* what it feels like */
  .feel { border-top: 1px solid var(--rule); }
  .feel-grid { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.15fr); gap: clamp(32px, 5vw, 72px); align-items: start; }
  .feel-lede { font-size: clamp(1.15rem, 1.6vw, 1.32rem); margin: 22px 0 16px; max-width: 34em; }
  .feel-copy .muted { max-width: 40em; }
  .feel-copy code { background: var(--code-bg); padding: 1px 6px; }
  .chat { margin: 0; border: 2px solid var(--ink); background: var(--paper); box-shadow: 10px 10px 0 var(--paper-3); }
  .chat-head { display: flex; justify-content: space-between; align-items: center; padding: 12px 16px; background: var(--ink); color: var(--paper); }
  .chat-head .label { color: var(--paper); opacity: 0.7; }
  .turns { list-style: none; margin: 0; padding: 6px 0; }
  .turns li { display: grid; grid-template-columns: 64px 1fr; gap: 12px; padding: 10px 16px; align-items: baseline; }
  .turns li.agent + li.you { border-top: 1px dashed var(--rule); }
  .turns p { margin: 0; font-size: 1.05rem; line-height: 1.45; }
  .turns .you p { font-family: var(--mono); font-size: 0.92rem; }
  .turns .agent .who { color: var(--signal); }
  .nudge { font-family: var(--display); font-stretch: 112%; font-weight: 700; text-decoration: underline; text-decoration-color: var(--signal); text-decoration-thickness: 2px; text-underline-offset: 0.2em; text-decoration-skip-ink: none; }
  .done { display: block; color: var(--ink-2); font-style: italic; }

  /* who it is for, how well tested */
  .who-section { padding-top: 0; }
  .tag-list { list-style: none; margin: 0; padding: 0; border-top: 2px solid var(--ink); }
  .tag-list li { display: grid; grid-template-columns: 132px 1fr; gap: 6px 20px; align-items: baseline; padding: 14px 0; border-bottom: 1px dashed var(--rule); }
  .tag {
    justify-self: start; padding: 3px 8px; border: 2px solid var(--signal); color: var(--signal);
    font-family: var(--mono); font-size: 0.72rem; font-weight: 500; letter-spacing: 0.08em; text-transform: uppercase; white-space: nowrap;
  }
  .tag.no { border-color: var(--ink-3); color: var(--ink-3); border-style: dashed; }
  .tag-list .line { font-size: 1.08rem; }
  .tested { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.25fr); gap: 24px clamp(32px, 6vw, 80px); margin-top: clamp(40px, 6vw, 72px); align-items: start; }
  .h3 { font-size: clamp(1.6rem, 3vw, 2.3rem); margin-bottom: 18px; }
  .tested-copy p { margin: 0 0 14px; max-width: 42ch; font-size: 1.12rem; }

  /* help */
