---
import Base from "../../layouts/Base.astro";
import { GUIDES, type Guide } from "../../data/guides";
import { REPO } from "../../data/kit";

export function getStaticPaths() {
  return GUIDES.map((g) => ({ params: { slug: g.slug }, props: { guide: g } }));
}

const { guide } = Astro.props as { guide: Guide };
const { Content } = guide.module;
const prev = GUIDES[guide.n - 1];
const next = GUIDES[guide.n + 1];
const toc = guide.module.getHeadings().filter((h) => h.depth === 2);
---

<Base title={`${guide.title} — onebox guides`} description={`${guide.title}. A plain guide from onebox.`} section="guides">
  <link slot="head" rel="alternate" type="text/markdown" href={`/guides/${guide.slug}.md`} title="This guide as markdown" />
  <div class="wrap guide-grid">
    <aside class="side">
      <nav aria-label="Guides">
        <p class="label side-head">Guides</p>
        <ol>
          {GUIDES.map((g) => (
            <li>
              <a href={`/guides/${g.slug}/`} aria-current={g.slug === guide.slug ? "page" : undefined}>
                <span class="label">{String(g.n).padStart(2, "0")}</span>
                <span>{g.title}</span>
              </a>
            </li>
          ))}
        </ol>
      </nav>
    </aside>

    <article class="prose">
      <div class="crumb">
        <p class="label">Guide {String(guide.n).padStart(2, "0")} of {String(GUIDES.length - 1).padStart(2, "0")}</p>
        <p class="label for-ai">For Claude: <a href={`/guides/${guide.slug}.md`}>.md</a> · <a href="/llms-full.txt">all guides</a></p>
      </div>
      {toc.length > 2 && (
        <details class="on-page">
          <summary class="label">On this page</summary>
          <ol>{toc.map((h) => <li><a href={`#${h.slug}`}>{h.text}</a></li>)}</ol>
        </details>
      )}
      <Content />
      <nav class="pager" aria-label="Next and previous guide">
        {prev ? <a href={`/guides/${prev.slug}/`} class="prev"><span class="label">← Previous</span><span>{prev.title}</span></a> : <span />}
        {next && <a href={`/guides/${next.slug}/`} class="next"><span class="label">Next →</span><span>{next.title}</span></a>}
      </nav>
      <p class="edit label"><a href={`${REPO}/blob/main/guides/${guide.slug}.md`}>Wrong or out of date? Fix it on GitHub.</a></p>
    </article>
  </div>
</Base>

<style>
  .guide-grid {
    display: grid;
    grid-template-columns: 260px minmax(0, 1fr);
    gap: clamp(32px, 5vw, 72px);
    padding-top: clamp(28px, 5vw, 56px);
  }
  .side nav { position: sticky; top: 80px; max-height: calc(100dvh - 104px); overflow: auto; }
  .side-head { margin: 0 0 10px; }
  .side ol { list-style: none; margin: 0; padding: 0; border-top: 2px solid var(--ink); }
  .side li { border-bottom: 1px solid var(--rule); }
  .side a {
    display: grid; grid-template-columns: 30px 1fr; gap: 8px; padding: 10px 0;
    text-decoration: none; font-family: var(--display); font-weight: 600; font-size: 0.92rem; line-height: 1.3;
  }
  .side a .label { padding-top: 2px; }
  .side a[aria-current="page"] { color: var(--signal); }
  .side a[aria-current="page"] .label { color: var(--signal); }

  .crumb { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 6px 16px; margin: 0 0 12px; }
  .prose .crumb p { margin: 0; font-size: 0.72rem; line-height: 1.4; }
  .for-ai { text-transform: none; letter-spacing: 0.02em; }
  .on-page { border: 1px solid var(--rule); padding: 10px 14px; margin: 0 0 28px; background: var(--paper-2); }
  .on-page summary { cursor: pointer; }
  .prose .on-page li { font-size: 1rem; }
  .on-page ol { margin: 10px 0 4px; padding-left: 1.2em; font-size: 1rem; }

  .pager { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; margin-top: 56px; border-top: 2px solid var(--ink); padding-top: 18px; }
  .pager a { display: grid; gap: 4px; text-decoration: none; font-family: var(--display); font-weight: 700; font-size: 1.1rem; }
  .pager .next { text-align: right; }
  .edit { margin-top: 28px; text-transform: none; letter-spacing: 0.02em; }

  @media (max-width: 900px) {
    .guide-grid { grid-template-columns: 1fr; }
    .side { order: 2; }
    .side nav { position: static; max-height: none; }
  }
</style>

<style is:global>
  .prose { max-width: var(--measure); min-width: 0; }
  .prose > :first-child { margin-top: 0; }
  .prose h1 {
    font-family: var(--display); font-stretch: 125%; font-weight: 800;
    font-size: clamp(2.1rem, 5vw, 3.4rem); letter-spacing: -0.02em; line-height: 1;
    margin: 0 0 28px;
  }
  .prose h2 {
    font-family: var(--display); font-stretch: 112%; font-weight: 700;
    font-size: clamp(1.35rem, 2.4vw, 1.7rem); letter-spacing: -0.01em; line-height: 1.15;
    margin: 2.4em 0 0.6em; padding-top: 14px; border-top: 2px solid var(--ink);
    scroll-margin-top: 24px;
  }
  .prose h3 { font-family: var(--display); font-weight: 700; font-size: 1.12rem; margin: 1.8em 0 0.4em; scroll-margin-top: 24px; }
  .prose p, .prose li { font-size: 1.14rem; line-height: 1.62; }
  .prose p { margin: 0 0 1em; }
  .prose ul, .prose ol { padding-left: 1.3em; margin: 0 0 1.1em; }
  .prose li { margin: 0.3em 0; }
  .prose li::marker { color: var(--ink-3); font-family: var(--mono); font-size: 0.85em; }
  .prose strong { font-weight: 600; }
  .prose a { text-decoration-color: color-mix(in oklab, var(--signal) 70%, transparent); }
  .prose hr { border: 0; border-top: 1px dashed var(--rule); margin: 2.4em 0; }
  .prose blockquote {
    margin: 1.4em 0; padding: 12px 18px; border-left: 3px solid var(--signal); background: var(--paper-2);
  }
  .prose blockquote p:last-child { margin: 0; }
  .prose :not(pre) > code {
    font-family: var(--mono); font-size: 0.84em; background: var(--code-bg); padding: 1px 5px; overflow-wrap: anywhere;
  }
  .prose pre {
    font-family: var(--mono); font-size: 0.86rem; line-height: 1.55;
    background: var(--code-bg) !important; color: var(--ink);
    border-left: 3px solid var(--ink); padding: 14px 16px; margin: 0 0 1.3em;
    overflow-x: auto; max-width: 100%;
  }
  .prose pre code { font-family: inherit; }
  .prose table { border-collapse: collapse; width: 100%; margin: 0 0 1.4em; font-size: 0.98rem; display: block; overflow-x: auto; }
  .prose th, .prose td { text-align: left; padding: 9px 12px 9px 0; border-bottom: 1px solid var(--rule); vertical-align: top; }
  .prose th { font-family: var(--mono); font-size: 0.72rem; font-weight: 500; letter-spacing: 0.08em; text-transform: uppercase; color: var(--ink-3); border-bottom: 2px solid var(--ink); }
  .prose input[type="checkbox"] { accent-color: var(--signal); margin-right: 8px; }

  /* shiki css-variables theme, mapped to ink */
  :root {
    --astro-code-foreground: var(--ink);
    --astro-code-background: var(--code-bg);
    --astro-code-token-constant: var(--ink);
    --astro-code-token-string: color-mix(in oklab, var(--signal) 75%, var(--ink));
    --astro-code-token-comment: var(--ink-3);
    --astro-code-token-keyword: var(--ink);
    --astro-code-token-parameter: var(--ink-2);
    --astro-code-token-function: var(--ink);
    --astro-code-token-string-expression: color-mix(in oklab, var(--signal) 75%, var(--ink));
    --astro-code-token-punctuation: var(--ink-3);
    --astro-code-token-link: var(--signal);
  }
</style>
