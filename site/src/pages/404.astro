---
// Cloudflare Pages serves dist/404.html, with status 404, for a path that does
// not exist. Without this file it serves the home page with status 200.
import Base from "../layouts/Base.astro";
---

<Base title="Page not found — onebox" description="This page does not exist. Start from the home page or the guides.">
  <meta slot="head" name="robots" content="noindex" />
  <main class="wrap page">
    <p class="kicker">404</p>
    <h1 class="display title">That page is not here.</h1>
    <p class="intro">
      The link may be old, or mistyped. Go to <a href="/">the home page</a>, the
      <a href="/guides/">guides</a>, or <a href="/llms.txt">llms.txt</a> for the full list.
    </p>
  </main>
</Base>

<style>
  .page { padding-top: clamp(40px, 7vw, 88px); padding-bottom: clamp(56px, 9vw, 112px); }
  .title { font-size: clamp(2.3rem, 6vw, 4.8rem); margin: 14px 0 22px; max-width: 16ch; }
  .intro { max-width: 52ch; color: var(--ink-2); font-size: 1.2rem; margin: 0; }
</style>
