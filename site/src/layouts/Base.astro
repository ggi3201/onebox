---
import "../styles/global.css";
import { REPO } from "../data/kit";
import { ASK_MAIL } from "../data/help";

interface Props {
  title: string;
  description: string;
  section?: "home" | "guides" | "help";
  // The sticky "Stuck on App Review?" bar on phones. Only / and /help/ set it.
  askbar?: boolean;
}
const { title, description, section = "home", askbar = false } = Astro.props;
// Shared links need absolute URLs. The image is docs/social-preview.png, copied to public/.
const SITE = Astro.site ?? "https://onebox.lokkesveen.com";
const image = new URL("/social-preview.png", SITE).href;
const imageAlt = "onebox: Get your app on the App Store. The route from your Mac, through Apple, to the phone.";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <!-- Bing Webmaster Tools ownership check for onebox.lokkesveen.com. -->
    <meta name="msvalidate.01" content="13D259E24ECE0F9FD966A98F092599BE" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={new URL(Astro.url.pathname, SITE).href} />
    <meta property="og:image" content={image} />
    <meta property="og:image:width" content="1280" />
    <meta property="og:image:height" content="640" />
    <meta property="og:image:alt" content={imageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />
    <meta name="twitter:image:alt" content={imageAlt} />
    <meta name="theme-color" content="#f2eee4" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#131210" media="(prefers-color-scheme: dark)" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <!-- Lets CSS keep the ask bar hidden until the script below has checked for a CTA on screen. -->
    <script is:inline>document.documentElement.classList.add("js");</script>
    <link rel="alternate" type="text/plain" href="/llms.txt" title="llms.txt" />
    <slot name="head" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Archivo:wdth,wght@62..125,400..900&family=IBM+Plex+Mono:wght@400;500&family=Newsreader:ital,opsz,wght@0,6..72,400..600;1,6..72,400..500&display=swap"
    />
  </head>
  <body class:list={{ "has-askbar": askbar }}>
    <header class="topbar">
      <div class="wrap">
        <a class="brand" href="/">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
            <path d="M3 7.5 12 3l9 4.5v9L12 21l-9-4.5v-9Z" stroke-linejoin="round" />
            <path d="M3 7.5 12 12l9-4.5M12 12v9" stroke-linejoin="round" />
          </svg>
          onebox
        </a>
        <div class="top-end">
          <nav aria-label="Main">
            <a href="/#start">Start</a>
            <a href="/#route">Road</a>
            <a href="/#contents">In the box</a>
            <a href="/guides/" aria-current={section === "guides" ? "page" : undefined}>Guides</a>
          </nav>
          <a class="topcta" href="/help/" aria-current={section === "help" ? "page" : undefined}>Get it live</a>
        </div>
      </div>
    </header>

    <slot />

    <footer class="footer">
      <div class="wrap">
        <p>
          Made by Geir-Stian Løkkesveen in Norway.
          Skills and guides are MIT licensed.
          Not affiliated with Apple, Expo or the other companies named here. Names and trademarks
          belong to their owners.
        </p>
        <p><a href={REPO}>Source on GitHub</a> · <a href="/guides/start-here/">Start here</a> · <a href="/changelog/">Changelog</a></p>
      </div>
    </footer>

    {askbar && (
      <aside class="askbar" aria-label="Ask for help" data-askbar>
        <div class="wrap">
          <p>Stuck on App Review?</p>
          <a class="btn accent" href={ASK_MAIL}>Ask <span aria-hidden="true">→</span></a>
        </div>
      </aside>
    )}

    <script>
      // The ask bar shows only while no CTA ([data-cta]) is on screen, so it never
      // repeats a button the reader can already see. Without JS it simply stays.
      const bar = document.querySelector<HTMLElement>("[data-askbar]");
      if (bar) {
        const ctas = document.querySelectorAll("[data-cta]");
        if (!("IntersectionObserver" in window) || ctas.length === 0) {
          bar.dataset.show = "";
        } else {
          const seen = new Set<Element>();
          const io = new IntersectionObserver((entries) => {
            for (const e of entries) e.isIntersecting ? seen.add(e.target) : seen.delete(e.target);
            bar.toggleAttribute("data-show", seen.size === 0);
          });
          ctas.forEach((c) => io.observe(c));
        }
      }

      document.querySelectorAll<HTMLButtonElement>("[data-copy]").forEach((btn) => {
        const label = btn.textContent;
        btn.addEventListener("click", async () => {
          try {
            await navigator.clipboard.writeText(btn.dataset.copy ?? "");
            btn.dataset.done = "";
            btn.textContent = "Copied";
          } catch { btn.textContent = "Select it"; }
          setTimeout(() => { delete btn.dataset.done; btn.textContent = label; }, 1400);
        });
      });
    </script>
  </body>
</html>
