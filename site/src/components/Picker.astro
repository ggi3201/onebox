---
// The picker: the same questions the /start:plan skill asks, answered with a
// click, and the "cart" they add up to (plugins to install, guides to read,
// skills that do the work). Both read one catalog.json, so they never drift.
import catalog from "../../../plugins/start/skills/plan/references/catalog.json";
import { REPO_SLUG } from "../data/kit";

type Q = { id: string; q: string; hint?: string; multi?: boolean; default: string | string[]; options: { id: string; label: string }[] };
const questions = catalog.questions as Q[];
---

<div class="picker" data-picker>
  <form class="qs" aria-label="What do you want to build?">
    {questions.map((q, i) => (
      <fieldset class="q">
        <legend><span class="label n">{String(i + 1).padStart(2, "0")}</span>{q.q}</legend>
        {q.hint && <p class="hint">{q.hint}</p>}
        <div class="opts">
          {q.options.map((o) => {
            const on = Array.isArray(q.default) ? q.default.includes(o.id) : q.default === o.id;
            return (
              <label class="opt">
                <input type={q.multi ? "checkbox" : "radio"} name={q.id} value={o.id} checked={on} />
                <span>{o.label}</span>
              </label>
            );
          })}
        </div>
      </fieldset>
    ))}
  </form>

  <aside class="cart" aria-live="polite">
    <div class="cart-head">
      <span class="kicker">Your cart</span>
      <span class="label" data-count></span>
    </div>

    <div class="cart-block">
      <p class="label">1 · Paste into Claude Code</p>
      <div class="cmdbox">
        <pre data-install></pre>
        <button type="button" data-copy-install>Copy all</button>
      </div>
      <p class="small">Codex, Cursor, Gemini CLI and others: <code>npx skills add {REPO_SLUG}</code> installs every skill.</p>
    </div>

    <div class="cart-block">
      <p class="label">2 · Paste this in your app’s folder</p>
      <div class="cmdbox">
        <pre class="prompt" data-prompt></pre>
        <button type="button" data-copy data-prompt-copy>Copy</button>
      </div>
      <p class="small">
        It carries your answers, so the plan skill does not ask them again. It checks what your app already
        has, asks only what is left, and writes the list below as <code>PLAN.md</code> (<a href="/example-plan/">see an example</a>).
        Codex, Cursor or another agent? <button type="button" class="linkbtn" data-copy data-prompt-other>Copy the version for other agents</button>.
      </p>
    </div>

    <div class="cart-block">
      <p class="label">3 · Work down the plan</p>
      <ol class="plan" data-plan></ol>
    </div>
  </aside>
</div>

<script type="application/json" id="onebox-catalog" set:html={JSON.stringify(catalog)} />
<script define:vars={{ repo: REPO_SLUG }}>
  const root = document.querySelector("[data-picker]");
  const catalog = JSON.parse(document.getElementById("onebox-catalog").textContent);
  const form = root.querySelector("form");
  const out = {
    install: root.querySelector("[data-install]"),
    plan: root.querySelector("[data-plan]"),
    prompt: root.querySelector("[data-prompt]"),
    promptCopy: root.querySelector("[data-prompt-copy]"),
    promptOther: root.querySelector("[data-prompt-other]"),
    count: root.querySelector("[data-count]"),
  };

  function answers() {
    const a = {};
    for (const q of catalog.questions) {
      const picked = [...form.querySelectorAll(`input[name="${q.id}"]:checked`)].map((i) => i.value);
      a[q.id] = q.multi ? picked : picked[0];
    }
    return a;
  }

  function matches(when, a) {
    if (!when) return true;
    return Object.entries(when).every(([qid, opts]) => {
      const v = a[qid];
      return Array.isArray(v) ? v.some((x) => opts.includes(x)) : opts.includes(v);
    });
  }

  function render() {
    const a = answers();
    const seen = new Set();
    const items = catalog.items.filter((it) => {
      const key = it.kind + ":" + (it.slug || it.id);
      if (!matches(it.when, a) || seen.has(key)) return false;
      seen.add(key);
      return true;
    });

    const plugins = [...new Set(items.filter((i) => i.kind === "skill").map((i) => i.plugin))];
    out.install.textContent = [
      `/plugin marketplace add ${repo}`,
      "/plugin install start@onebox",
      ...plugins.map((p) => `/plugin install ${p}@onebox`),
    ].join("\n");

    const said = `My answers from the onebox site: ${JSON.stringify(a)}`;
    out.prompt.textContent = `/start:plan ${said}`;
    out.promptCopy.dataset.copy = `/start:plan ${said}`;
    out.promptOther.dataset.copy = `Use the onebox plan skill. ${said}`;

    const todo = items.filter((i) => !(i.doneWhen && matches(i.doneWhen, a)));
    const guides = todo.filter((i) => i.kind === "guide").length;
    const skills = todo.length - guides;
    out.count.textContent = `${plugins.length + 1} plugins · ${guides} guides · ${skills} skills`;

    out.plan.replaceChildren(
      ...catalog.phases
        .map((ph) => ({ ph, list: items.filter((i) => i.phase === ph.id) }))
        .filter((g) => g.list.length)
        .map(({ ph, list }) => {
          const li = document.createElement("li");
          const h = document.createElement("p");
          h.className = "phase";
          h.textContent = ph.title;
          const ul = document.createElement("ul");
          for (const it of list) {
            const row = document.createElement("li");
            const likely = !!it.doneWhen && matches(it.doneWhen, a);
            row.className = it.kind + (likely ? " likely" : "");
            if (likely) row.title = "Likely done already";
            if (it.kind === "guide") {
              const link = document.createElement("a");
              link.href = `/guides/${it.slug || it.id}/`;
              link.textContent = it.title;
              row.append(link);
            } else {
              const t = document.createElement("span");
              t.textContent = it.title + " ";
              const c = document.createElement("code");
              c.textContent = `/${it.plugin}:${it.slug || it.id}`;
              row.append(t, c);
            }
            if (likely) {
              const tag = document.createElement("span");
              tag.className = "tag";
              tag.textContent = "likely done";
              row.append(tag);
            }
            ul.append(row);
          }
          li.append(h, ul);
          return li;
        }),
    );
  }

  form.addEventListener("change", render);
  root.querySelector("[data-copy-install]").addEventListener("click", async (e) => {
    const btn = e.currentTarget;
    try {
      await navigator.clipboard.writeText(out.install.textContent);
      btn.textContent = "Copied";
    } catch {
      btn.textContent = "Select it";
    }
    setTimeout(() => (btn.textContent = "Copy all"), 1400);
  });
  render();
</script>

<style>
  .picker {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.05fr);
    gap: clamp(24px, 4vw, 56px);
    align-items: start;
  }

  .qs { display: grid; gap: 18px; }
  .q { border: 0; border-top: 1px solid var(--rule); margin: 0; padding: 14px 0 0; min-width: 0; }
  .q legend {
    display: flex; gap: 12px; align-items: baseline; padding: 0;
    font-family: var(--display); font-stretch: 112%; font-weight: 700; font-size: 1.08rem;
  }
  .q .n { flex: none; }
  .hint { margin: 6px 0 0 34px; color: var(--ink-3); font-size: 0.95rem; }
  .opts { display: grid; gap: 6px; margin: 10px 0 0 34px; }
  .opt {
    display: flex; gap: 10px; align-items: flex-start; cursor: pointer;
    padding: 8px 10px; border: 1px solid var(--rule); background: var(--paper);
    font-size: 1rem; line-height: 1.35;
    transition: border-color 140ms, background 140ms;
  }
  .opt:hover { border-color: var(--ink); }
  .opt:has(input:checked) { border-color: var(--ink); background: var(--paper-2); box-shadow: inset 3px 0 0 var(--signal); }
  .opt input { margin: 3px 0 0; accent-color: var(--signal); flex: none; }

  .cart {
    position: sticky; top: 80px;
    border: 2px solid var(--ink); background: var(--paper);
    box-shadow: 8px 8px 0 var(--paper-3);
  }
  .cart-head {
    display: flex; justify-content: space-between; align-items: center; gap: 12px;
    padding: 12px 16px; background: var(--ink); color: var(--paper);
  }
  .cart-head .label { color: var(--paper); opacity: 0.75; text-transform: none; letter-spacing: 0.02em; }
  .cart-block { padding: 14px 16px; border-bottom: 1px solid var(--rule); }
  .cart-block:last-child { border-bottom: 0; }
  .cart-block > .label { margin: 0 0 8px; }
  .small { margin: 8px 0 0; font-size: 0.95rem; color: var(--ink-2); }
  .small code { font-family: var(--mono); font-size: 0.85em; }

  .cmdbox { display: flex; border: 1px solid var(--ink); min-width: 0; }
  .cmdbox pre {
    flex: 1; min-width: 0; margin: 0; padding: 10px 12px; overflow-x: auto;
    font-family: var(--mono); font-size: 0.8rem; line-height: 1.6; background: var(--code-bg);
    scrollbar-width: none;
  }
  .cmdbox button {
    flex: none; border: 0; border-left: 1px solid var(--ink); background: transparent; color: var(--ink);
    font-family: var(--mono); font-size: 0.72rem; letter-spacing: 0.08em; text-transform: uppercase;
    padding: 0 12px; cursor: pointer;
  }
  .cmdbox button:hover { background: var(--ink); color: var(--paper); }
  .cmdbox button[data-done] { background: var(--signal); color: var(--signal-ink); }
  .cmdbox pre.prompt { white-space: pre-wrap; overflow-wrap: anywhere; }
  .linkbtn {
    border: 0; padding: 0; background: none; color: inherit; font: inherit; cursor: pointer;
    text-decoration: underline; text-decoration-color: color-mix(in oklab, var(--signal) 60%, transparent); text-underline-offset: 0.18em;
  }
  .linkbtn:hover { color: var(--signal); }
  .linkbtn[data-done] { color: var(--signal); text-decoration: none; }

  .plan { list-style: none; margin: 0; padding: 0; display: grid; gap: 12px; max-height: 520px; overflow: auto; }
  .plan :global(.phase) {
    margin: 0 0 4px; font-family: var(--display); font-stretch: 112%; font-weight: 700; font-size: 0.95rem;
  }
  .plan :global(ul) { list-style: none; margin: 0; padding: 0; }
  .plan :global(li li) {
    display: flex; flex-wrap: wrap; gap: 2px 8px; align-items: baseline;
    padding: 5px 0 5px 18px; position: relative; font-size: 0.98rem; line-height: 1.35;
    border-bottom: 1px dashed var(--rule);
  }
  .plan :global(li li::before) {
    content: ""; position: absolute; left: 2px; top: 11px; width: 8px; height: 8px; border: 1.5px solid var(--ink-3);
  }
  .plan :global(li.skill::before) { border-color: var(--signal); background: var(--signal); }
  .plan :global(li.likely) { color: var(--ink-3); }
  .plan :global(li.likely a) { color: var(--ink-3); }
  .plan :global(li.likely::before) { background: var(--ink-3); border-color: var(--ink-3); }
  .plan :global(.tag) {
    font-family: var(--mono); font-size: 0.68rem; letter-spacing: 0.06em; text-transform: uppercase;
    color: var(--ink-3); border: 1px solid var(--rule); padding: 0 5px;
  }
  .plan :global(code) { font-family: var(--mono); font-size: 0.78rem; color: var(--ink-2); }
  .plan :global(a) { text-decoration-color: color-mix(in oklab, var(--signal) 60%, transparent); }

  .qs, .cart { min-width: 0; }
  @media (max-width: 900px) {
    .picker { grid-template-columns: minmax(0, 1fr); }
    .cart { position: static; }
    .plan { max-height: none; }
  }
  @media (max-width: 520px) {
    .opts, .hint { margin-left: 0; }
    .cmdbox { flex-direction: column; }
    .cmdbox button { border-left: 0; border-top: 1px solid var(--ink); padding: 10px 12px; }
    .cart-head { flex-wrap: wrap; }
  }
</style>
